{
    "name": "kg-bot/hookbox",
    "description": "Hookbox — the inbox for your Laravel webhooks. Receive, verify, dedupe, replay.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "webhook",
        "inbox",
        "replay",
        "idempotency"
    ],
    "homepage": "https://github.com/kg-bot/hookbox",
    "support": {
        "issues": "https://github.com/kg-bot/hookbox/issues",
        "source": "https://github.com/kg-bot/hookbox"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/pagination": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.11 || ^3.0",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.12.17 || ^2.1.44",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "Hookbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hookbox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hookbox\\HookboxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
